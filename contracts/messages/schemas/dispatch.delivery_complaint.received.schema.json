{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.delivery-dispatch.local/messages/schemas/dispatch.delivery_complaint.received.schema.json",
  "title": "dispatch.delivery_complaint.received",
  "description": "Acuse asíncrono a CRM: Despachos persistió el reclamo una sola vez y abrió la investigación vinculada al despacho. Significa persistencia idempotente, no confirmación comercial ni aprobación de RMA. Un reenvío del mismo `messageId` repite este acuse con los mismos datos. Sin datos personales ni tracking_token.",
  "type": "object",
  "allOf": [{ "$ref": "../envelope.schema.json" }],
  "properties": {
    "type": { "const": "dispatch.delivery_complaint.received" },
    "source": { "const": "dispatch" },
    "schemaVersion": { "const": 1 },
    "data": { "$ref": "#/$defs/data" }
  },
  "$defs": {
    "data": {
      "type": "object",
      "required": ["correlationMessageId", "crmCaseId", "caseVersion", "dispatchId", "trackingCode", "receivedAt"],
      "properties": {
        "correlationMessageId": {
          "description": "`messageId` del `crm.delivery_complaint.opened` que originó el acuse.",
          "$ref": "../envelope.schema.json#/$defs/messageId"
        },
        "crmCaseId": { "$ref": "../envelope.schema.json#/$defs/entityId" },
        "caseVersion": {
          "description": "Versión del caso que quedó registrada.",
          "type": "integer",
          "minimum": 1
        },
        "dispatchId": {
          "description": "Despacho individual al que quedó vinculado el reclamo.",
          "type": "integer",
          "minimum": 1
        },
        "trackingCode": {
          "$ref": "../envelope.schema.json#/$defs/trackingCode"
        },
        "receivedAt": {
          "description": "Momento en que Despachos persistió el reclamo.",
          "$ref": "../envelope.schema.json#/$defs/dateTimeUtc"
        }
      },
      "additionalProperties": false
    }
  }
}
