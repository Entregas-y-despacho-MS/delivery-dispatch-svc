{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.delivery-dispatch.local/messages/schemas/marketplace.sales_order.cancelled.schema.json",
  "title": "marketplace.sales_order.cancelled",
  "description": "Cancelación de un pedido de venta.",
  "type": "object",
  "allOf": [{ "$ref": "../envelope.schema.json" }],
  "properties": {
    "type": { "const": "marketplace.sales_order.cancelled" },
    "source": { "const": "marketplace" },
    "schemaVersion": { "const": 1 },
    "data": { "$ref": "#/$defs/data" }
  },
  "$defs": {
    "data": {
      "type": "object",
      "required": ["salesOrderId", "recordVersion", "updatedAt", "cancelledAt"],
      "properties": {
        "salesOrderId": { "$ref": "../envelope.schema.json#/$defs/entityId" },
        "recordVersion": { "$ref": "../envelope.schema.json#/$defs/recordVersion" },
        "updatedAt": { "$ref": "../envelope.schema.json#/$defs/dateTimeUtc" },
        "cancelledAt": { "$ref": "../envelope.schema.json#/$defs/dateTimeUtc" },
        "reason": { "type": "string", "maxLength": 500 }
      },
      "additionalProperties": false
    }
  }
}
