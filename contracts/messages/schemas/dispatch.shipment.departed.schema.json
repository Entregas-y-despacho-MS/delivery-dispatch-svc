{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.delivery-dispatch.local/messages/schemas/dispatch.shipment.departed.schema.json",
  "title": "dispatch.shipment.departed",
  "description": "Salida física de los bultos y transferencia de custodia al repartidor, al iniciar la ruta. Se emite un mensaje por pedido de la ruta.",
  "type": "object",
  "allOf": [{ "$ref": "../envelope.schema.json" }],
  "properties": {
    "type": { "const": "dispatch.shipment.departed" },
    "source": { "const": "dispatch" },
    "schemaVersion": { "const": 1 },
    "data": { "$ref": "#/$defs/data" }
  },
  "$defs": {
    "data": {
      "type": "object",
      "required": ["salesOrderId", "trackingCode", "recordVersion", "updatedAt", "departedAt", "driverId", "packageIds"],
      "properties": {
        "salesOrderId": { "$ref": "../envelope.schema.json#/$defs/entityId" },
        "trackingCode": { "$ref": "dispatch.transfer.status_changed.schema.json#/$defs/trackingCode" },
        "recordVersion": { "$ref": "../envelope.schema.json#/$defs/recordVersion" },
        "updatedAt": { "$ref": "../envelope.schema.json#/$defs/dateTimeUtc" },
        "departedAt": {
          "description": "Hora de salida física de los bultos (transferencia de custodia).",
          "$ref": "../envelope.schema.json#/$defs/dateTimeUtc"
        },
        "driverId": {
          "description": "ID del repartidor que recibe la custodia.",
          "$ref": "../envelope.schema.json#/$defs/entityId"
        },
        "packageIds": {
          "description": "IDs de los bultos que salen, tal como los informó Almacén.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "../envelope.schema.json#/$defs/entityId" }
        }
      },
      "additionalProperties": false
    }
  }
}
