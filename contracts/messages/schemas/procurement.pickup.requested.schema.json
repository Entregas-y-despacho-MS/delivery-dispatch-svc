{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.delivery-dispatch.local/messages/schemas/procurement.pickup.requested.schema.json",
  "title": "procurement.pickup.requested",
  "description": "Solicitud de recogida en proveedor ligada a una orden de compra aprobada. Dirección, almacén destino y horario son opcionales en el esquema: si falta un dato imprescindible, Despachos deja la solicitud pendiente de corrección en lugar de rechazar el mensaje. Estimaciones en kg y m³.",
  "type": "object",
  "allOf": [{ "$ref": "../envelope.schema.json" }],
  "properties": {
    "type": { "const": "procurement.pickup.requested" },
    "source": { "const": "procurement" },
    "schemaVersion": { "const": 1 },
    "data": { "$ref": "#/$defs/data" }
  },
  "$defs": {
    "data": {
      "type": "object",
      "required": ["purchaseOrderId", "recordVersion", "updatedAt", "supplier", "products"],
      "properties": {
        "purchaseOrderId": { "$ref": "../envelope.schema.json#/$defs/entityId" },
        "recordVersion": { "$ref": "../envelope.schema.json#/$defs/recordVersion" },
        "updatedAt": { "$ref": "../envelope.schema.json#/$defs/dateTimeUtc" },
        "approvedAt": {
          "description": "Momento en que se aprobó la orden de compra.",
          "$ref": "../envelope.schema.json#/$defs/dateTimeUtc"
        },
        "supplier": { "$ref": "#/$defs/supplier" },
        "contact": { "$ref": "marketplace.sales_order.confirmed.schema.json#/$defs/recipient" },
        "pickupAddress": { "$ref": "marketplace.sales_order.confirmed.schema.json#/$defs/deliveryAddress" },
        "pickupWindow": { "$ref": "#/$defs/pickupWindow" },
        "warehouseId": {
          "description": "Almacén destino; Despachos completa dirección y horario con el catálogo Warehouse.",
          "$ref": "../envelope.schema.json#/$defs/entityId"
        },
        "products": { "$ref": "#/$defs/products" },
        "estimates": { "$ref": "#/$defs/estimates" }
      },
      "additionalProperties": false
    },
    "supplier": {
      "type": "object",
      "required": ["supplierId", "name"],
      "properties": {
        "supplierId": { "$ref": "../envelope.schema.json#/$defs/entityId" },
        "name": { "type": "string", "minLength": 1, "maxLength": 150 }
      },
      "additionalProperties": false
    },
    "pickupWindow": {
      "description": "Horario en que el proveedor permite la recogida, en UTC.",
      "type": "object",
      "required": ["startsAt", "endsAt"],
      "properties": {
        "startsAt": { "$ref": "../envelope.schema.json#/$defs/dateTimeUtc" },
        "endsAt": { "$ref": "../envelope.schema.json#/$defs/dateTimeUtc" }
      },
      "additionalProperties": false
    },
    "products": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/product" }
    },
    "product": {
      "type": "object",
      "required": ["productId", "quantity"],
      "properties": {
        "productId": { "$ref": "../envelope.schema.json#/$defs/entityId" },
        "description": { "type": "string", "maxLength": 300 },
        "quantity": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "estimates": {
      "description": "Estimaciones de la carga: cantidad de bultos, peso en kg y volumen en m³.",
      "type": "object",
      "properties": {
        "packages": { "type": "integer", "minimum": 1 },
        "weightKg": { "type": "number", "exclusiveMinimum": 0 },
        "volumeM3": { "type": "number", "exclusiveMinimum": 0 }
      },
      "additionalProperties": false
    }
  }
}
