{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.delivery-dispatch.local/messages/schemas/procurement.pickup.updated.schema.json",
  "title": "procurement.pickup.updated",
  "description": "Cambio en la orden de compra mientras la recogida sigue pendiente. Cada bloque enviado reemplaza completo al anterior; un campo ausente no cambia. Debe venir al menos un campo modificado además de los de identificación (`minProperties: 4`).",
  "type": "object",
  "allOf": [{ "$ref": "../envelope.schema.json" }],
  "properties": {
    "type": { "const": "procurement.pickup.updated" },
    "source": { "const": "procurement" },
    "schemaVersion": { "const": 1 },
    "data": { "$ref": "#/$defs/data" }
  },
  "$defs": {
    "data": {
      "type": "object",
      "required": ["purchaseOrderId", "recordVersion", "updatedAt"],
      "properties": {
        "purchaseOrderId": { "$ref": "../envelope.schema.json#/$defs/entityId" },
        "recordVersion": { "$ref": "../envelope.schema.json#/$defs/recordVersion" },
        "updatedAt": { "$ref": "../envelope.schema.json#/$defs/dateTimeUtc" },
        "supplier": { "$ref": "procurement.pickup.requested.schema.json#/$defs/supplier" },
        "contact": { "$ref": "marketplace.sales_order.confirmed.schema.json#/$defs/recipient" },
        "pickupAddress": { "$ref": "marketplace.sales_order.confirmed.schema.json#/$defs/deliveryAddress" },
        "pickupWindow": { "$ref": "procurement.pickup.requested.schema.json#/$defs/pickupWindow" },
        "warehouseId": { "$ref": "../envelope.schema.json#/$defs/entityId" },
        "products": { "$ref": "procurement.pickup.requested.schema.json#/$defs/products" },
        "estimates": { "$ref": "procurement.pickup.requested.schema.json#/$defs/estimates" }
      },
      "minProperties": 4,
      "additionalProperties": false
    }
  }
}
