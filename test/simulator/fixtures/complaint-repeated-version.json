        "data": {
          "crmCaseId": "CRM-CASE-SIM-0004",
          "caseVersion": 1,
          "dispatchId": 482,
          "trackingCode": "DSP-2026-00482",
          "reasonCode": "DAMAGED_ITEM",
          "openedAt": "2026-11-21T11:58:00Z",
          "affectedItems": [
            {
              "packageId": "PKG-SIM-0001-1",
              "quantity": 1
            }
          ]
        }
      }
    },
    {
      "label": "CRM actualiza el caso (versión 2)",
      "realDispatch": true,
      "expectAck": {
