# Server
NODE_ENV=development
PORT=3000
API_PREFIX=api

# CORS — '*', un solo origen, o una lista separada por comas
CORS_ORIGINS=*

# TRUST_PROXY (ST-224.1) — cuántos saltos de proxy inverso confiar en X-Forwarded-For.
# Vacío/'false': no confía en nada (IP del socket). Es el valor para desarrollo local, sin proxy delante.
# Solo detrás de un único proxy real (ej. la plataforma de despliegue), usar 1 — sin proxy, cualquier
# cliente podría falsificar su IP con ese header y saltarse el límite por IP de /public/tracking/*.
# También acepta una lista separada por comas de IPs/CIDR/'loopback'/'linklocal'/'uniquelocal'. 'true' no se acepta.
TRUST_PROXY=
# TRUST_PROXY=1

# Database (PostgreSQL)
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password
DB_NAME=your_database
DB_LOGS=false

CACHE_ADAPTER=redis
REDIS_HOST=localhost
REDIS_PORT=6379
# Deja ambos vacíos/false en local. La mayoría de Redis gestionado en la nube (ElastiCache con auth,
# Memorystore, Upstash, Redis Cloud...) exige REDIS_PASSWORD y/o REDIS_TLS=true.
REDIS_PASSWORD=
REDIS_TLS=false

# Seed — crea un usuario de cada rol operativo (menos admin) para poder probar un despliegue
# recién levantado sin crear cuentas a mano. Contraseñas de desarrollo: cambiarlas en cualquier
# otro entorno.
SEED_ROOT_USERNAME=root
SEED_ROOT_FULL_NAME=Root
SEED_ROOT_EMAIL=root@app.com
SEED_ROOT_PASSWORD=Root1234!

# Los 3 usuarios demo de abajo (supervisor/coordinator/driver) usan una contraseña fija escrita en
# seed.ts — el seed corre en cada arranque del contenedor (ver CMD del Dockerfile), así que en
# producción (NODE_ENV=production) se omiten por defecto. Solo se crean ahí si se pasa
# SEED_DEMO_USERS=true explícitamente.
# SEED_DEMO_USERS=true

SEED_SUPERVISOR_USERNAME=supervisor
SEED_SUPERVISOR_FULL_NAME=Supervisor de Flota
SEED_SUPERVISOR_EMAIL=supervisor@app.com
SEED_SUPERVISOR_PASSWORD=Supervisor1234!

SEED_COORDINATOR_USERNAME=coordinator
SEED_COORDINATOR_FULL_NAME=Coordinador de Despacho
SEED_COORDINATOR_EMAIL=coordinator@app.com
SEED_COORDINATOR_PASSWORD=Coordinator1234!

SEED_DRIVER_USERNAME=driver
SEED_DRIVER_FULL_NAME=Repartidor Demo
SEED_DRIVER_EMAIL=driver@app.com
SEED_DRIVER_PASSWORD=Driver1234!

# Auth (JWT)
# Generar secrets con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
ACTIVE_JWT=true
JWT_SECRET=your_jwt_secret_here
JWT_TIME_EXPIRE=15m
JWT_REFRESH_SECRET=your_refresh_secret_here
JWT_REFRESH_TIME_EXPIRE=7d

# Simulated SMS — enable body logs only on an isolated local development instance
SMS_SIMULATED_LOG_BODY=false

# Mailer — MAILER_TRANSPORT en 'smtp', 'api' o 'log'
MAILER_TRANSPORT=smtp
MAILER_BOUNCE_EMAIL=bounce@example.test

# SMTP (si MAILER_TRANSPORT=smtp)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASS=your_password
SMTP_FROM="My App <noreply@example.com>"

# API, ej. Resend (si MAILER_TRANSPORT=api)
# MAILER_API_URL=https://api.resend.com/emails
# MAILER_API_KEY=your_api_key
# MAILER_FROM=noreply@yourdomain.com

# WebSockets
WEBSOCKET_NAMESPACE=app

# PDF (Puppeteer) — true funciona en host normal y en Docker sin permisos extra
PUPPETEER_NO_SANDBOX=true

# OSRM — motor de ruteo, ver ../osrm-svc/
OSRM_URL=http://localhost:5001

# Storage — STORAGE_PROVIDER en 'local' o 'cloudinary'
STORAGE_PROVIDER=local

# Local (si STORAGE_PROVIDER=local)
UPLOADS_DIR=uploads
PUBLIC_URL=http://localhost:3000
PUBLIC_WEB_URL=http://localhost:5173

# Cloudinary (si STORAGE_PROVIDER=cloudinary)
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_FOLDER=delivery-dispatch

# Push notifications — PUSH_PROVIDER en 'expo' o 'firebase'
PUSH_PROVIDER=expo

# Expo Server SDK (si PUSH_PROVIDER=expo)
# EXPO_ACCESS_TOKEN=your_expo_access_token

# Firebase (si PUSH_PROVIDER=firebase — el "to" debe ser un FID, no un token FCM viejo)
# FIREBASE_PROJECT_ID=your_project_id
# FIREBASE_CLIENT_EMAIL=your_service_account@your_project.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Rate limiting (@nestjs/throttler) — límite por defecto de toda la API
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100
# change-password and the 2FA endpoints (they verify a secret of an already-logged-in user), per THROTTLE_TTL_MS
THROTTLE_SENSITIVE_LIMIT=10
# public tracking page (/public/tracking/*): requests per client IP per THROTTLE_TTL_MS
THROTTLE_PUBLIC_TRACKING_LIMIT=20

# -- Plugin: messaging (Google Cloud Pub/Sub) --
# Local integration uses the Pub/Sub emulator from the workspace Docker Compose.
MESSAGING_ADAPTER=pubsub
PUBSUB_PROJECT_ID=delivery-dispatch-local
# Local host address; Compose overrides it with pubsub-emulator:8085 inside the app container.
PUBSUB_EMULATOR_HOST=localhost:8085
PUBSUB_SUBSCRIPTION_SUFFIX=dispatch-svc
# Para GCP real, reemplaza PUBSUB_PROJECT_ID por el ID de proyecto, deja PUBSUB_EMULATOR_HOST vacío,
# y configura una subscription existente asociada al topic compartido. Ver README.md.
# PUBSUB_PROJECT_ID=project-a96e5fe1-5ba6-4698-a85
# PUBSUB_EMULATOR_HOST=
# PUBSUB_INBOUND_TOPIC=ucb-sis323-sub-h
# PUBSUB_INBOUND_SUBSCRIPTION=ucb-sis323-sub-h-dispatch-svc
MESSAGING_CONTRACTS_DIR=contracts/messages
# Outbox publisher: 0 disables the timer
OUTBOX_POLL_INTERVAL_MS=2000
OUTBOX_SLOW_RETRY_SECONDS=60
OUTBOX_GIVE_UP_AFTER_MINUTES=240
OUTBOX_BATCH_SIZE=20
OUTBOX_LEASE_SECONDS=60
OUTBOX_PUBLISH_TIMEOUT_MS=10000

# Scheduler: false turns the minute tick off (manual triggers still work)
SCHEDULER_ENABLED=true

# -- OSRM routing engine: table API limits (ST-50.2) -------------------------
# Must not exceed the instance --max-table-size (default 100). Bigger matrices are split into blocks.
OSRM_TABLE_MAX_COORDINATES=100
# Abort an OSRM request after this many ms and answer 503 OSRM_UNAVAILABLE.
OSRM_TIMEOUT_MS=5000
